<script>
const toast=document.getElementById('toast');
let toastTimer;
function notify(msg){toast.textContent=msg;toast.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>toast.classList.remove('show'),2800)}
const search=document.getElementById('failSearch'), suiteFilter=document.getElementById('suiteFilter'), errorFilter=document.getElementById('errorFilter');
function filterFailures(){
  const q=search.value.trim().toLowerCase(), suite=suiteFilter.value, error=errorFilter.value;
  let shown=0;
  document.querySelectorAll('#failTable tbody tr').forEach(row=>{
    const text=row.innerText.toLowerCase();
    const visible=(!q||text.includes(q))&&(!suite||row.dataset.suite===suite)&&(!error||row.dataset.error===error);
    row.style.display=visible?'':'none';if(visible)shown++;
  });
  document.getElementById('failCount').textContent=`Showing ${shown} matching sample failures of 74 total · connect to output.xml for live report data`;
}
[search,suiteFilter,errorFilter].forEach(el=>el.addEventListener(el==search?'input':'change',filterFailures));
document.getElementById('durationMode').addEventListener('click',()=>{
  document.getElementById('durationMode').style.background='#eaf3ff';document.getElementById('durationMode').style.color='#086cff';
  document.getElementById('countMode').style.background='#fff';document.getElementById('countMode').style.color='#6379a9';
  document.querySelectorAll('.duration-row').forEach(row=>{row.querySelector('.bar-fill').style.width=(Number(row.dataset.duration)/29.3*100)+'%';});
  notify('Showing suite runtime share');
});
document.getElementById('countMode').addEventListener('click',()=>{
  document.getElementById('countMode').style.background='#eaf3ff';document.getElementById('countMode').style.color='#086cff';
  document.getElementById('durationMode').style.background='#fff';document.getElementById('durationMode').style.color='#6379a9';
  document.querySelectorAll('.duration-row').forEach(row=>{row.querySelector('.bar-fill').style.width=(Number(row.dataset.count)/25.3*100)+'%';});
  notify('Showing relative test-case counts');
});
document.getElementById('viewSuites').addEventListener('click',()=>notify('Connect the report to Robot Framework output.xml to load all 18 suites.'));
document.querySelectorAll('[data-message]').forEach(btn=>btn.addEventListener('click',()=>notify(btn.dataset.message)));
document.querySelectorAll('[data-file]').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();notify(`Artifact "${a.dataset.file}" needs its Jenkins URL configured.`)}));
document.querySelectorAll('.pagination button').forEach(btn=>btn.addEventListener('click',()=>{if(!btn.classList.contains('active'))notify('Pagination is a visual placeholder until the complete execution dataset is connected.')}));
document.querySelectorAll('#suiteTable tbody tr').forEach(row=>row.addEventListener('click',()=>{row.style.background=row.style.background?'':'#f4f8ff'}));
</script>
