<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Robot Framework | Automation Execution Report</title>
<style>
:root{
  --ink:#09194f; --muted:#6076ae; --blue:#1672ff; --blue2:#4b9bff;
  --green:#10b981; --red:#ff414b; --amber:#ffad24; --purple:#8064ff;
  --line:#e3ebf8; --panel:#ffffff; --bg:#f4f8ff; --pale:#edf4ff;
  --shadow:0 4px 18px rgba(30,78,150,.035);
}
*{box-sizing:border-box}
body{margin:0;background:linear-gradient(115deg,#f5f9ff 0%,#f1f7ff 58%,#f8fbff 100%);color:var(--ink);font-family:Inter,"Segoe UI",Roboto,Arial,sans-serif;font-size:12px;line-height:1.35}
button,input,select{font:inherit}
button{cursor:pointer}
.page{max-width:1600px;margin:0 auto;padding:14px 18px 22px}
.topbar{height:56px;display:flex;align-items:center;gap:18px;padding:0 20px;margin-bottom:10px}
.brand{display:flex;align-items:center;gap:10px;min-width:290px}
.brand-icon{width:45px;height:45px;border-radius:12px;background:linear-gradient(145deg,#328aff,#0055ed);display:grid;place-items:center;color:white;box-shadow:0 6px 14px #1975ff25}
.brand-icon svg{width:25px;height:25px}
.brand-title{font-size:20px;font-weight:750;letter-spacing:-.55px;line-height:1.1}
.brand-sub{font-size:13px;color:#3e5790;margin-top:3px}
.version{font-size:11px;font-weight:700;color:#2567d9;background:#e6f0ff;border-radius:6px;padding:4px 8px;margin-left:2px}
.top-spacer{flex:1}
.run-date{display:flex;align-items:center;gap:10px;color:#172b61;font-size:12px;min-width:260px}
.run-date svg{width:20px;height:20px;color:#5473b4}
.subtext{font-size:10px;color:#7287b8;margin-top:2px}
.status{display:flex;align-items:center;gap:8px;background:#dcfbec;color:#07985c;border:1px solid #c7f5de;border-radius:9px;padding:9px 13px;min-width:177px}
.status svg{width:22px;height:22px}
.status strong{font-size:12px;letter-spacing:.1px}
.status small{display:block;font-size:10px;margin-top:1px;color:#26976a}
.panel{background:rgba(255,255,255,.94);border:1px solid #edf2fb;border-radius:12px;box-shadow:var(--shadow)}
.meta-strip{display:grid;grid-template-columns:1.15fr .8fr 1.15fr 1.15fr 1.25fr 1.15fr .8fr;align-items:center;min-height:69px;padding:8px 10px;margin-bottom:13px}
.meta-item{display:flex;align-items:center;gap:10px;min-width:0;padding:4px 12px;border-right:1px solid #e8eef9}
.meta-item:last-child{border-right:0}
.meta-icon{flex:0 0 35px;width:35px;height:35px;border-radius:10px;background:#f0f6ff;color:#1472ff;display:grid;place-items:center}
.meta-icon svg{width:19px;height:19px}
.meta-label{font-size:10px;color:#657cb2;margin-bottom:3px}
.meta-value{font-size:11.5px;font-weight:650;color:#12275d;overflow-wrap:anywhere;line-height:1.3}
.meta-value.normal{font-weight:500}
.kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin-bottom:14px}
.kpi{height:105px;padding:13px 14px;display:flex;align-items:flex-start;gap:11px;position:relative;overflow:hidden}
.kpi-icon{width:46px;height:46px;flex:0 0 46px;border-radius:50%;display:grid;place-items:center;background:#eaf3ff;color:#1472ff}
.kpi-icon svg{width:24px;height:24px}
.kpi-copy{min-width:0;z-index:1}
.kpi-label{font-size:12px;color:#415a95;margin:2px 0 5px}
.kpi-value{font-size:29px;font-weight:750;letter-spacing:-1px;line-height:1.03;white-space:nowrap}
.kpi-foot{font-size:10.5px;color:#7287b8;margin-top:7px;white-space:nowrap}
.kpi.pass{background:linear-gradient(105deg,#fff,#f0fff8)}
.kpi.pass .kpi-icon{background:#e5fbf0;color:#0aa76b}
.kpi.pass .kpi-value,.kpi.pass .kpi-foot{color:#0ba76b}
.kpi.fail{background:linear-gradient(105deg,#fff,#fff3f4)}
.kpi.fail .kpi-icon{background:#fff0f1;color:#ff414b}
.kpi.fail .kpi-value,.kpi.fail .kpi-foot{color:#ff414b}
.kpi.skip .kpi-icon{background:#f0f3fa;color:#687ba4}
.kpi .spark{position:absolute;right:10px;bottom:14px;width:54px;height:44px;opacity:.68}
.kpi .spark rect{fill:#91baff}
.kpi.pass .spark rect{fill:#72d9b3}.kpi.fail .spark rect{fill:#ff9ca2}
.kpi .kpi-copy{padding-right:34px}
.kpi.duration .kpi-copy{padding-right:0}
.kpi.duration .spark{width:65px;right:8px}
.insight-grid{display:grid;grid-template-columns:1.22fr .94fr .84fr;gap:11px;margin-bottom:14px}
.chart-panel{padding:14px 16px 12px;min-height:229px}
.panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:11px}
.panel-title{font-size:15px;font-weight:750;letter-spacing:-.3px}
.panel-desc{font-size:10.5px;color:#7084b3;margin-top:4px}
.legend{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:10px;color:#6478a8}
.legend span{display:flex;align-items:center;gap:4px;white-space:nowrap}
.dot{display:inline-block;width:9px;height:9px;border-radius:3px}
.dot.green{background:#23bd89}.dot.red{background:#ff525b}.dot.gray{background:#aab8d1}.dot.blue{background:#1775ff}
.chart-svg{width:100%;height:168px;display:block}
.duration-list{display:flex;flex-direction:column;gap:12px;margin-top:14px}
.duration-row{display:grid;grid-template-columns:minmax(112px,1.15fr) minmax(70px,1fr) auto;align-items:center;gap:10px;font-size:10.5px;color:#536b9f}
.bar-track{height:16px;background:#edf3fc;border-radius:4px;overflow:hidden}
.bar-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,#59a8ff,#3986ff)}
.bar-value{white-space:nowrap;text-align:right;color:#50679c;font-size:10.5px}
.failure-layout{display:grid;grid-template-columns:132px 1fr;gap:13px;align-items:center;margin-top:12px}
.donut{width:132px;height:132px;border-radius:50%;background:conic-gradient(#ff474f 0 43%,#ffae2a 43% 67%,#4da7ff 67% 83%,#8268ff 83% 94%,#b4bfd4 94% 100%);display:grid;place-items:center;position:relative}
.donut:before{content:"";position:absolute;inset:22px;background:white;border-radius:50%}
.donut-center{position:relative;text-align:center}
.donut-center strong{display:block;font-size:23px;letter-spacing:-.6px}
.donut-center span{font-size:10px;color:#7185b5}
.failure-legend{display:flex;flex-direction:column;gap:11px}
.failure-legend .row{display:grid;grid-template-columns:10px 1fr auto;align-items:center;gap:7px;font-size:10.5px}
.failure-legend .row strong{font-size:10.5px}
.suite-panel{padding:12px 16px 10px;margin-bottom:13px}
.section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:9px}
.section-title{font-size:15px;font-weight:750;letter-spacing:-.25px}
.section-title small{font-weight:500;color:#6f83b4;font-size:11px;margin-left:5px}
.link-btn{border:0;background:transparent;color:#086cff;font-weight:600;padding:5px 0;font-size:11px;white-space:nowrap}
.table-wrap{overflow-x:auto}
table{width:100%;border-collapse:separate;border-spacing:0;font-size:10.5px;white-space:nowrap}
thead th{text-align:left;background:#f2f7ff;color:#536a9e;font-size:9px;text-transform:uppercase;letter-spacing:.35px;font-weight:700;padding:8px 10px;border-top:1px solid #e8effa;border-bottom:1px solid #e8effa}
thead th:first-child{border-radius:5px 0 0 5px}thead th:last-child{border-radius:0 5px 5px 0}
tbody td{padding:7px 10px;border-bottom:1px solid #edf2fa;color:#324b85}
tbody tr:last-child td{border-bottom:0}
tbody tr:hover td{background:#f8fbff}
.center{text-align:center}.right{text-align:right}
.green-text{color:#0aa76b!important}.red-text{color:#ff414b!important}.muted{color:#7a8db9!important}
.passbar{display:flex;align-items:center;gap:8px;min-width:150px}
.passbar .track{width:105px;height:9px;background:#eaf0fa;border-radius:4px;overflow:hidden}
.passbar .fill{height:100%;background:linear-gradient(90deg,#57aaff,#3485ff);border-radius:4px}
.passbar .fill.low{background:linear-gradient(90deg,#ff686e,#ff4b52)}
.fail-panel{padding:12px 16px 10px;margin-bottom:13px}
.fail-tools{display:flex;align-items:center;gap:8px}
.search{width:270px;border:1px solid #dfe8f7;background:#fff;border-radius:7px;padding:8px 10px;color:#263f78;outline:none}
.search:focus,select:focus{border-color:#75aaff;box-shadow:0 0 0 3px #e7f1ff}
select{border:1px solid #dfe8f7;background:#fff;color:#314b83;border-radius:7px;padding:8px 10px;outline:none;max-width:150px}
.error-cell{color:#ff414b;max-width:390px;overflow:hidden;text-overflow:ellipsis}
.error-wrap{display:flex;align-items:center;gap:7px}
.error-icon{width:14px;height:14px;border-radius:50%;background:#ff414b;color:white;display:inline-grid;place-items:center;font-size:10px;font-weight:800;flex:0 0 14px}
.retry{display:inline-block;padding:4px 7px;border-radius:5px;background:#eaf3ff;color:#2878ee;font-weight:700}
.retry.bad{background:#fff0f0;color:#ff414b}
.evidence{display:flex;align-items:center;justify-content:center;gap:12px;color:#5372ad}
.evidence button{border:0;background:transparent;color:#5473ad;padding:0;display:grid;place-items:center}
.evidence svg{width:15px;height:15px}
.row-open{color:#0872ff;font-size:16px}
.table-footer{display:flex;justify-content:space-between;align-items:center;color:#8092b9;font-size:10px;padding:9px 2px 0}
.pagination{display:flex;gap:4px;align-items:center}
.pagination button{border:1px solid #e3ebf8;background:#fff;color:#6076aa;border-radius:5px;padding:4px 8px}
.pagination button.active{background:#176dff;color:#fff;border-color:#176dff}
.artifacts{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8px}
.artifact{border:1px solid #e2ebf9;border-radius:8px;padding:9px 10px;display:flex;align-items:center;gap:8px;min-width:0;background:#fff;color:inherit;text-decoration:none;transition:.15s}
.artifact:hover{border-color:#a8caff;background:#f9fbff;transform:translateY(-1px)}
.artifact-icon{width:34px;height:34px;border-radius:8px;background:#eff6ff;color:#1772ff;display:grid;place-items:center;flex:0 0 34px}
.artifact-icon svg{width:19px;height:19px}
.artifact-name{font-size:10.5px;font-weight:650;overflow:hidden;text-overflow:ellipsis}
.artifact-size{font-size:9.5px;color:#7c8fba;margin-top:3px}
.footer-note{display:flex;justify-content:space-between;gap:12px;padding:12px 4px 0;color:#8798bc;font-size:9.5px}
.toast{position:fixed;right:22px;bottom:22px;background:#0b1d50;color:white;padding:12px 16px;border-radius:9px;box-shadow:0 8px 30px #09245c30;opacity:0;transform:translateY(8px);pointer-events:none;transition:.2s;z-index:10}
.toast.show{opacity:1;transform:translateY(0)}
@media(max-width:1200px){.meta-strip{grid-template-columns:repeat(4,1fr)}.meta-item:nth-child(4){border-right:0}.meta-item:nth-child(n+5){border-top:1px solid #edf2fa}.kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.insight-grid{grid-template-columns:1fr 1fr}.insight-grid .failure-panel-inline{grid-column:1/-1}.artifacts{grid-template-columns:repeat(4,minmax(0,1fr))}.brand{min-width:250px}}
@media(max-width:760px){.page{padding:8px}.topbar{padding:0 4px;gap:8px;height:auto;flex-wrap:wrap}.brand{min-width:0;flex:1}.brand-title{font-size:17px}.brand-sub{font-size:11px}.run-date{min-width:0}.status{min-width:0;padding:7px}.meta-strip{grid-template-columns:repeat(2,minmax(0,1fr));padding:6px}.meta-item{border-right:0!important;border-bottom:1px solid #edf2fa;padding:8px 5px}.meta-item:nth-last-child(-n+1){border-bottom:0}.kpis{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.kpi{height:100px;padding:10px;gap:8px}.kpi-icon{width:36px;height:36px;flex-basis:36px}.kpi-value{font-size:24px}.kpi-label{font-size:11px}.kpi-foot{font-size:9px}.insight-grid{grid-template-columns:1fr}.chart-panel{min-height:0}.chart-svg{height:160px}.section-head{align-items:flex-start;flex-direction:column}.fail-tools{width:100%;flex-wrap:wrap}.search{width:100%}.artifacts{grid-template-columns:repeat(2,minmax(0,1fr))}.failure-layout{grid-template-columns:110px 1fr}.donut{width:110px;height:110px}.donut:before{inset:18px}.footer-note{flex-direction:column}}
@media print{body{background:#fff}.page{max-width:none;padding:0}.panel{box-shadow:none;break-inside:avoid}.topbar{padding:0}.link-btn,.fail-tools,.pagination{display:none}.artifacts{grid-template-columns:repeat(4,1fr)}}
</style>
</head>
